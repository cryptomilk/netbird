diff --git a/shared/signal/client/health_test.go b/shared/signal/client/health_test.go
new file mode 100644
index 000000000..d62ee2cc2
--- /dev/null
+++ b/shared/signal/client/health_test.go
@@ -0,0 +1,130 @@
+package client
+
+import (
+	"context"
+	"net"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"golang.zx2c4.com/wireguard/wgctrl/wgtypes"
+	"google.golang.org/grpc"
+	"google.golang.org/grpc/connectivity"
+	"google.golang.org/grpc/credentials/insecure"
+
+	sigProto "github.com/netbirdio/netbird/shared/signal/proto"
+)
+
+type recordingNotifier struct {
+	mu        sync.Mutex
+	connected bool
+}
+
+func (n *recordingNotifier) MarkSignalDisconnected(error) {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	n.connected = false
+}
+
+func (n *recordingNotifier) MarkSignalConnected() {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	n.connected = true
+}
+
+func (n *recordingNotifier) isConnected() bool {
+	n.mu.Lock()
+	defer n.mu.Unlock()
+	return n.connected
+}
+
+// TestIsHealthyRequiresRegisteredStream covers the status reporting half of a
+// stuck registration: the gRPC connection to Signal is up but no stream is
+// registered, so no peer can reach this client. The health check used to look
+// at the connection only, reporting Signal as connected throughout.
+func TestIsHealthyRequiresRegisteredStream(t *testing.T) {
+	addr := startTestSignalServer(t)
+
+	key, err := wgtypes.GenerateKey()
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+
+	client, err := NewClient(ctx, addr, key, false)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = client.Close() })
+
+	notifier := &recordingNotifier{}
+	client.SetConnStateListener(notifier)
+
+	assert.False(t, client.IsHealthy(), "no registered stream must not be reported healthy")
+	assert.False(t, notifier.isConnected(), "no registered stream must not mark Signal connected")
+
+	// Stop Receive before Close runs (cleanups are LIFO), so the two never overlap.
+	receiveDone := make(chan struct{})
+	go func() {
+		defer close(receiveDone)
+		_ = client.Receive(ctx, func(*sigProto.Message) error { return nil })
+	}()
+	t.Cleanup(func() {
+		cancel()
+		<-receiveDone
+	})
+
+	streamReady := make(chan struct{})
+	go func() {
+		client.WaitStreamConnected(ctx)
+		close(streamReady)
+	}()
+	select {
+	case <-streamReady:
+	case <-time.After(5 * time.Second):
+		t.Fatal("signal stream did not connect within timeout")
+	}
+
+	assert.True(t, client.IsHealthy(), "a registered stream on a usable connection must be healthy")
+	assert.True(t, notifier.isConnected(), "a registered stream must mark Signal connected")
+}
+
+// TestIsHealthyConnectingWithoutStream covers the window while the connection is
+// still being established: a TCP listener that accepts but never speaks HTTP/2
+// keeps the channel in Connecting, and with no registered stream the client
+// cannot receive anything yet, so it must not be reported healthy.
+func TestIsHealthyConnectingWithoutStream(t *testing.T) {
+	lis, err := net.Listen("tcp", "127.0.0.1:0")
+	require.NoError(t, err)
+	var mu sync.Mutex
+	var accepted []net.Conn
+	t.Cleanup(func() {
+		_ = lis.Close()
+		mu.Lock()
+		defer mu.Unlock()
+		for _, c := range accepted {
+			_ = c.Close()
+		}
+	})
+	go func() {
+		for {
+			c, err := lis.Accept()
+			if err != nil {
+				return
+			}
+			mu.Lock()
+			accepted = append(accepted, c)
+			mu.Unlock()
+		}
+	}()
+
+	conn, err := grpc.NewClient(lis.Addr().String(), grpc.WithTransportCredentials(insecure.NewCredentials()))
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = conn.Close() })
+	conn.Connect()
+	require.Eventually(t, func() bool { return conn.GetState() == connectivity.Connecting }, 5*time.Second, 10*time.Millisecond,
+		"channel should be stuck connecting to a listener that never answers")
+
+	client := &GrpcClient{signalConn: conn, status: StreamDisconnected}
+	assert.False(t, client.IsHealthy(), "a connecting channel with no registered stream must not be reported healthy")
+}
diff --git a/shared/signal/client/registration_test.go b/shared/signal/client/registration_test.go
new file mode 100644
index 000000000..7703f843d
--- /dev/null
+++ b/shared/signal/client/registration_test.go
@@ -0,0 +1,86 @@
+package client
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/otel"
+	"golang.zx2c4.com/wireguard/wgctrl/wgtypes"
+
+	sigProto "github.com/netbirdio/netbird/shared/signal/proto"
+	"github.com/netbirdio/netbird/signal/server"
+)
+
+// stallingSignalServer holds the first ConnectStream open without ever sending
+// the registration header, while the transport keeps answering keepalive pings.
+// Later streams go to the real server. This is what a responder in front of or
+// inside Signal looks like when it accepts a stream and never answers it.
+type stallingSignalServer struct {
+	*server.Server
+	stalled atomic.Bool
+	held    chan struct{}
+}
+
+func (s *stallingSignalServer) ConnectStream(stream sigProto.SignalExchange_ConnectStreamServer) error {
+	if s.stalled.CompareAndSwap(false, true) {
+		close(s.held)
+		<-stream.Context().Done()
+		return stream.Context().Err()
+	}
+	return s.Server.ConnectStream(stream)
+}
+
+// TestReceiveRetriesWhenRegistrationHeaderNeverArrives reproduces a client stuck
+// forever waiting for the registration header of a stream the server side never
+// answers: the receive watchdog only starts after registration, so nothing ended
+// the wait and Signal never came back until the daemon was restarted. The client
+// must give up on the silent stream and register on a new one.
+func TestReceiveRetriesWhenRegistrationHeaderNeverArrives(t *testing.T) {
+	realServer, err := server.NewServer(context.Background(), otel.Meter(""))
+	require.NoError(t, err)
+	stalling := &stallingSignalServer{Server: realServer, held: make(chan struct{})}
+	addr := serveTestSignalExchange(t, stalling)
+
+	key, err := wgtypes.GenerateKey()
+	require.NoError(t, err)
+
+	ctx, cancel := context.WithCancel(context.Background())
+	t.Cleanup(cancel)
+
+	client, err := NewClient(ctx, addr, key, false)
+	require.NoError(t, err)
+	t.Cleanup(func() { _ = client.Close() })
+	client.registrationTimeout = 200 * time.Millisecond
+
+	// Stop Receive before Close runs (cleanups are LIFO), so the two never overlap.
