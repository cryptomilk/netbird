From d2c520a1dd6252972935c41e71cac64737747623 Mon Sep 17 00:00:00 2001
From: riccardom <riccardomanfrin@gmail.com>
Date: Wed, 14 Oct 2026 20:08:25 +0200
Subject: [PATCH 15/15] [client] Retry a failed routed allowed IPs reconcile on
 the next evaluation

keepChosenRoute recorded the connected status before re-applying the routed
allowed IPs and only logged a failed reconcile. Later evaluations then saw
an unchanged status and never retried, so a transient AddAllowedIP failure
left the recreated routing peer without its routed prefixes until another
status transition or a route switch.

The status is now recorded only once the reconcile succeeds. A failure
leaves the previous status in place, so the next evaluation, at the latest
the periodic re-evaluation, sees the change again and retries.
---
 client/internal/routemanager/client/client.go | 25 +++++++++------
 .../routemanager/client/client_test.go        | 32 +++++++++++++++++++
 2 files changed, 48 insertions(+), 9 deletions(-)

diff --git a/client/internal/routemanager/client/client.go b/client/internal/routemanager/client/client.go
index fed315aee..66c2ed491 100644
--- a/client/internal/routemanager/client/client.go
+++ b/client/internal/routemanager/client/client.go
@@ -788,24 +788,31 @@ func (w *Watcher) keepChosenRoute(newChosenID route.ID, newStatus routerPeerStat
 		return false
 	}
 
-	if w.currentChosenStatus != nil && w.currentChosenStatus.status != newStatus.status {
-		w.currentChosen = newChosenRoute
-		w.currentChosenStatus = &newStatus
-		if newStatus.status == peer.StatusConnected {
-			w.reconcileRoutedAllowedIPs(newChosenRoute.Peer)
-		}
+	if w.currentChosenStatus == nil || w.currentChosenStatus.status == newStatus.status {
+		return true
+	}
+
+	// a failed reconcile leaves the previous status recorded, so the next
+	// evaluation sees the change again and retries
+	if newStatus.status == peer.StatusConnected && !w.reconcileRoutedAllowedIPs(newChosenRoute.Peer) {
+		return true
 	}
 
+	w.currentChosen = newChosenRoute
+	w.currentChosenStatus = &newStatus
+
 	return true
 }
 
-func (w *Watcher) reconcileRoutedAllowedIPs(peerKey string) {
+func (w *Watcher) reconcileRoutedAllowedIPs(peerKey string) bool {
 	if w.reconcileAllowedIPs == nil {
-		return
+		return true
 	}
 	if err := w.reconcileAllowedIPs(peerKey); err != nil {
-		log.Warnf("failed to reconcile routed allowed IPs of routing peer %s for [%v]: %v", peerKey, w.handler, err)
+		log.Warnf("failed to reconcile routed allowed IPs of routing peer %s for [%v], will retry: %v", peerKey, w.handler, err)
+		return false
 	}
+	return true
 }
 
 func (w *Watcher) recalculateRoutes(rsn reason, routerPeerStatuses map[route.ID]routerPeerStatus) error {
diff --git a/client/internal/routemanager/client/client_test.go b/client/internal/routemanager/client/client_test.go
index 527b31231..641383e90 100644
--- a/client/internal/routemanager/client/client_test.go
+++ b/client/internal/routemanager/client/client_test.go
@@ -2,6 +2,7 @@ package client
 
 import (
 	"context"
+	"errors"
 	"fmt"
 	"net/netip"
 	"sync"
@@ -1530,3 +1531,34 @@ func TestRecalculateRoutesReconcilesAllowedIPsOnConnect(t *testing.T) {
 	assert.Equal(t, []string{"peer1"}, handler.added, "the reconcile must not go through the refcounted add")
 	assert.Equal(t, 0, handler.removed, "the allowed IPs must not be removed")
 }
+
+// A failed reconcile must be retried: the new status is only recorded once the
+// routed allowed IPs are back, so the next evaluation tries again.
+func TestRecalculateRoutesRetriesFailedReconcile(t *testing.T) {
+	w, _ := newRecalcWatcher(t)
+	calls := 0
+	w.reconcileAllowedIPs = func(string) error {
+		calls++
+		if calls == 1 {
+			return errors.New("add allowed IP: transient failure")
+		}
+		return nil
+	}
+
+	connected := map[route.ID]routerPeerStatus{"route1": {status: peer.StatusConnected}}
+	require.NoError(t, w.recalculateRoutes(reasonPeerUpdate, connected))
+	require.NoError(t, w.recalculateRoutes(reasonPeerUpdate, map[route.ID]routerPeerStatus{
+		"route1": {status: peer.StatusIdle},
+	}))
+
+	require.NoError(t, w.recalculateRoutes(reasonPeerUpdate, connected))
+	require.Equal(t, 1, calls, "connecting must reconcile")
+	assert.Equal(t, peer.StatusIdle, w.currentChosenStatus.status, "a failed reconcile must not record the new status")
+
+	require.NoError(t, w.recalculateRoutes(reasonPeerUpdate, connected))
+	assert.Equal(t, 2, calls, "the next evaluation must retry the reconcile")
+	assert.Equal(t, peer.StatusConnected, w.currentChosenStatus.status, "a successful reconcile records the status")
+
+	require.NoError(t, w.recalculateRoutes(reasonPeerUpdate, connected))
+	assert.Equal(t, 2, calls, "nothing to retry once the reconcile succeeded")
+}
